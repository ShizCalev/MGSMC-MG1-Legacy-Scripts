#, 0
msgid ""
"I'M GREY FOX.\n"
"\n"
"THE ULTIMATE WEAPON\n"
"METAL GEAR HAS\n"
"\n"
"NUCLEAR WEAPONS\n"
"DESIGNED FOR EVERY\n"
"PART OF EARTH.\n"
"\n"
"IF IT IS COMPLETED,\n"
"NUCLEAR ATTACK\n"
"\n"
"FROM ANYWHWRE\n"
"\n"
"WILL BE\n"
"POSSIBLE.\n"
"\n"
"METAL GEAR MUST BE\n"
"DESTOROYED,\n"
"\n"
"BEFORE IT IS\n"
"COMPLETED.\n"
"\n"
"THERE IS ONLY ONE\n"
"WAY TO DESTOROY\n"
"METAL GEAR.\n"
"\n"
"DR. PETTROVICH, WHO\n"
"DEVELOPED IT KNOW\n"
"THE ONLY METHOD."
msgstr ""

#, 0
msgid ""
"I'M DR. PETTROVICH.\n"
"\n"
"MY DAUGHTER ELLEN\n"
"WAS TAKEN\n"
"AS HOSTAGE.\n"
"\n"
"SAVE ELLEN\n"
"OR, I WON'T DISCUSS\n"
"METAL GEAR."
msgstr ""

#, 0
msgid ""
"THANK YOU.\n"
"\n"
"I'M THE DAUGHTER OF\n"
"DR. PETTROVICH,\n"
"ELLEN.\n"
"\n"
"MY FATHER WAS\n"
"FORCED TO DEVELOP\n"
"METAL GEAR.\n"
"\n"
"PLEASE HELP\n"
"MY FATHER\n"
"URGENTLY."
msgstr ""

#, 1
msgid "RESCUED"
msgstr ""

#, 0
msgid ""
"RESCUED!\n"
"\n"
"FOXHOUNDER\n"
"INTRUDED\n"
"A FEW DAYS AGO\n"
"\n"
"AND IS SAFE NOW.\n"
"\n"
"HE WAS CAPTURED BY\n"
"THE ENEMY."
msgstr ""

#, 1
msgid "RESCUED"
msgstr ""

#, 0
msgid ""
"RESCUED!\n"
"\n"
"RESISTANCE, DIANE\n"
"WILL SUPPORT YOU\n"
"ON WAVEBAND 12033."
msgstr ""

#, 0
msgid ""
"RESCUED!\n"
"\n"
"FOXHOUNDER\n"
"CALLED\n"
"GREY FOX MUST BE\n"
"\n"
"CONFINED IN\n"
"THE SECRET CELL."
msgstr ""

#, 0
msgid ""
"RESCUED!\n"
"\n"
"THE BEST WAY OF\n"
"GAINING ACCESS TO\n"
"THE SECRET CELL,\n"
"\n"
"IS TO ALLOW THE\n"
"ENEMY TO CAPTURE\n"
"YOU."
msgstr ""

#, 0
msgid ""
"RESCUED!\n"
"\n"
"THE ONLY WAY TO\n"
"REACH THE COURTYARD\n"
"IS BY PARACHUTE."
msgstr ""

