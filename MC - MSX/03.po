#, 0
msgid ""
"RESCUED!\n"
"\n"
"BOSS OF\n"
"OUTER HEAVEN IS\n"
"BIG BOSS,\n"
"\n"
"GENERAL COMMANDANT\n"
"OF FOXHOUND.\n"
"\n"
"EVERYTHING IS DONE\n"
"BY HIM."
msgstr ""

#, 0
msgid ""
"I'M DR. PETTROVICH.\n"
"\n"
"METAL GEAR IS IN\n"
"100TH BASEMENT OF\n"
"BUILDING NO.3,\n"
"\n"
"20KM TO THE NORTH\n"
"OF HERE.\n"
"\n"
"METAL GEAR CAN BE\n"
"DESTOROYED\n"
"IN ONLY ONE WAY.\n"
"\n"
"ATTACH PLASTIC BOMB\n"
"TO THE FOOT OF\n"
"METAL GEAR.\n"
"\n"
"R ,R ,L ,R ,L ,L ,R ,L ,L ,\n"
"R ,R ,L ,R ,L ,R ,...\n"
"IN ORDER .\n"
"\n"
"I FORGOT\n"
"THE REMAINDER.\n"
"\n"
"ANYWAY,\n"
"\n"
"SET 16 UNITS.\n"
"\n"
"YOU CAN NOT,\n"
"DESTOROY\n"
"\n"
"IF YOU COMMIT\n"
"AN ERROR\n"
"IN THE ORDER.\n"
"\n"
"MR. ARNOLD HAS\n"
"AN I.D. CARD\n"
"\n"
"TO GET OUT OF\n"
"BUILDING NO.2.\n"
"\n"
"YOU SHOULD USE\n"
"A ROCKET LAUNCHER\n"
"TO KILL MR. ARNOLD."
msgstr ""

#, 0
msgid ""
"YOU ARE CAUGHT IN\n"
"A TRAP.\n"
"\n"
"IN FACT,\n"
"\n"
"WE HAVE CONFINED\n"
"DR. PETTROVICH ON\n"
"THE SECOND FLOOR.\n"
"\n"
"I WILL GET YOU\n"
"FOXHOUNDER!"
msgstr ""

