msgid ""
"RESCUED!\n"
"\n"
"DR. PETTROVICH WAS\n"
"QUICKLY MOVED TO\n"
"BUILDING NO .2.\n"
"\n"
"BUILDING NO .2 LIES\n"
"10KM TO THE NORTH\n"
"FROM HERE."
msgstr ""

